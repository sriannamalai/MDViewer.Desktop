{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDownViewer",
  "version": "0.1.0",
  "identifier": "dev.sriannamalai.mdviewer",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "MarkDownViewer",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 680,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": ["../vendor/libmdviewer/darwin-arm64/libmdviewer.dylib"]
    }
  }
}
